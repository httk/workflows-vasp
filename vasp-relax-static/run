#!/usr/bin/env python3
"""One relaxation followed by one static calculation, chained in one job.

The five steps are the whole workflow, each delegating to the
``httk.workflow.vasp`` step API: ``prepare`` and ``run`` are the relaxation
(:func:`~httk.workflow.vasp.stage_vasp_inputs`,
:func:`~httk.workflow.vasp.run_vasp_step`), ``promote`` archives the
relaxation, makes its CONTCAR the new structure, and re-derives the inputs for
a single point (:func:`~httk.workflow.vasp.promote_vasp_relaxation`), ``static``
runs that single point, and ``publish`` publishes both stages
(:func:`~httk.workflow.vasp.publish_vasp_files`) — the relaxation under
``relax/`` and the single point under ``static/``.

This is the *httk* v1 formation-energy template without its database half: a
formation energy is assembled at job_records time from the total energies of several
such jobs and the elemental references they are compared against, which is an
analysis over finished jobs rather than a step of one job. What this runner
guarantees is the pair of numbers that assembly needs — one relaxed structure and
one total energy of it, both with the evidence of how they were produced.

Both stages share one job: one remedy budget, one remedy ladder, one workdir. The
job inputs and parameters are documented in this repository's README. Nothing here
imports anything but an installed *httk-workflow*, so this one file is the whole
runner: it is the entry of this package directory, reference it by git URI
(e.g. ``git+https://github.com/httk/workflows-vasp#vasp-relax-static``) or with
``--workflow-dir``, publish it to a workspace runner store, or copy it and edit it.
"""

import os
import sys

try:
    from httk.workflow import Attempt, Runner
    from httk.workflow.vasp import (
        promote_vasp_relaxation,
        publish_vasp_files,
        run_vasp_step,
        stage_vasp_inputs,
        vasp_data_prefix,
    )
except ModuleNotFoundError:  # pragma: no cover - interpreter bootstrap
    # The manager launches this file directly, so the interpreter is whatever the
    # shebang found on PATH, which on a cluster is not necessarily the one httk is
    # installed in. HTTK_WORKFLOW_PYTHON is the interpreter the manager itself runs,
    # so re-exec under it once and let a second failure be reported honestly.
    _python = os.environ.get("HTTK_WORKFLOW_PYTHON")
    if _python is None or os.environ.get("HTTK_WORKFLOW_RUNNER_BOOTSTRAP") == "1":
        raise
    os.environ["HTTK_WORKFLOW_RUNNER_BOOTSTRAP"] = "1"
    os.execv(_python, [_python, os.path.abspath(__file__), *sys.argv[1:]])

WORKFLOW = "vasp.relax-static"
#: Where the relaxation is archived inside the workdir before it is overwritten.
RELAX_ARCHIVE = "relax"

run = Runner(WORKFLOW)


@run.step
def prepare(a: Attempt) -> None:
    """Stage the payload inputs, derive the rest, and go on to relax.

    :param a: Prepare and advance this VASP attempt.
    """

    if stage_vasp_inputs(a) is not None:
        a.advance("run")


@run.step(name="run")
def run_step(a: Attempt) -> None:
    """Relax, remedy a recognized failure, or fail with what was diagnosed.

    :param a: Execute this relaxation attempt.
    """

    run_vasp_step(a, next_step="promote")


@run.step
def promote(a: Attempt) -> None:
    """Archive the relaxation, adopt its CONTCAR, and derive the static inputs.

    :param a: Promote the completed relaxation in this attempt.
    """

    promote_vasp_relaxation(a, next_step="static", archive=RELAX_ARCHIVE)


@run.step
def static(a: Attempt) -> None:
    """Run the single point, remedy a recognized failure, or fail.

    :param a: Execute the static stage in this attempt.
    """

    run_vasp_step(a, next_step="publish")


@run.step
def publish(a: Attempt) -> None:
    """Publish both stages and complete the job.

    :param a: Publish both stages and complete this attempt.
    """

    prefix = vasp_data_prefix(a, "")
    publish_vasp_files(a, prefix=f"{prefix}/static" if prefix else "static")
    publish_vasp_files(
        a,
        prefix=f"{prefix}/{RELAX_ARCHIVE}" if prefix else RELAX_ARCHIVE,
        directory=a.workdir / RELAX_ARCHIVE,
    )
    a.state["static_energy"] = a.state.get("energy")
    a.succeed()


if __name__ == "__main__":
    raise SystemExit(run.main())
