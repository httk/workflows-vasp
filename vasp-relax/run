#!/usr/bin/env python3
"""One VASP relaxation: prepare inputs, run with remedies, publish the result.

The three steps are the whole workflow, each delegating to the
``httk.workflow.vasp`` step API: ``prepare`` stages the payload inputs and
derives the rest (:func:`~httk.workflow.vasp.stage_vasp_inputs`), ``run``
executes VASP under supervision and applies the reviewed remedy ladder
(:func:`~httk.workflow.vasp.run_vasp_step`), and ``publish`` publishes the
files that describe the finished calculation
(:func:`~httk.workflow.vasp.publish_vasp_files`).

The job inputs and parameters are documented in this repository's README. Nothing
here imports anything but an installed *httk-workflow*, so this one file is the
whole runner: it is the entry of this package directory, reference it by git URI
(e.g. ``git+https://github.com/httk/workflows-vasp#vasp-relax``) or with
``--workflow-dir``, publish it to a workspace runner store, or copy it and edit it.
"""

import os
import sys

try:
    from httk.workflow import Attempt, Runner
    from httk.workflow.vasp import (
        publish_vasp_files,
        run_vasp_step,
        stage_vasp_inputs,
        vasp_data_prefix,
    )
except ModuleNotFoundError:  # pragma: no cover - interpreter bootstrap
    # The manager launches this file directly, so the interpreter is whatever the
    # shebang found on PATH, which on a cluster is not necessarily the one httk is
    # installed in. HTTK_WORKFLOW_PYTHON is the interpreter the manager itself runs,
    # so re-exec under it once and let a second failure be reported honestly.
    _python = os.environ.get("HTTK_WORKFLOW_PYTHON")
    if _python is None or os.environ.get("HTTK_WORKFLOW_RUNNER_BOOTSTRAP") == "1":
        raise
    os.environ["HTTK_WORKFLOW_RUNNER_BOOTSTRAP"] = "1"
    os.execv(_python, [_python, os.path.abspath(__file__), *sys.argv[1:]])

WORKFLOW = "vasp.relax"

run = Runner(WORKFLOW)


@run.step
def prepare(a: Attempt) -> None:
    """Stage the payload inputs, derive the rest, and go on to run VASP.

    :param a: Prepare and advance this VASP attempt.
    """

    if stage_vasp_inputs(a) is not None:
        a.advance("run")


@run.step(name="run")
def run_step(a: Attempt) -> None:
    """Run VASP, remedy a recognized failure, or fail with what was diagnosed.

    :param a: Execute this VASP workflow attempt.
    """

    run_vasp_step(a, next_step="publish")


@run.step
def publish(a: Attempt) -> None:
    """Publish the finished calculation and complete the job.

    :param a: Publish results and complete this VASP attempt.
    """

    publish_vasp_files(a, prefix=vasp_data_prefix(a))
    a.succeed()


if __name__ == "__main__":
    raise SystemExit(run.main())
